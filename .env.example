# ─────────────────────────────────────────────────────────────────────
# 保利威黑客松 · 环境变量模板（仓库根目录版）
# 真正生效的那份在 秒记卡/.env.local —— 服务端用 --env-file-if-exists=.env.local 读它。
# 这里的值给 scripts/*.mjs（拉数据、灌样例卡、校验）用，保持一致即可。
# 完整说明：docs/配置说明.md
# ─────────────────────────────────────────────────────────────────────

# ── 必填 ①：保利威直播 Open API（MD5 签名）──────────────────────────
# 保利威直播后台 → 设置 → 开发者信息
POLYV_APP_ID=
POLYV_APP_SECRET=

# ── 必填 ②：保利威点播 Open API（SHA1 签名）────────────────────────
# 保利威点播后台 → 设置 → 开发者信息
POLYV_VOD_USERID=
POLYV_VOD_SECRETKEY=

# ── 必填 ③：频道号 ──────────────────────────────────────────────────
# 观看页地址 https://live.polyv.cn/watch/<这串数字>
# 留空会退回代码里的兜底常量 8569582（别人的频道）
POLYV_DEMO_CHANNEL_ID=

# ── 选填 ④：默认打开哪条视频（留空 = 该频道点播列表第一条）──────────
# 留空时教师端默认复盘标题是空的（vod:），建议填上
POLYV_DEMO_VIDEO_ID=
POLYV_DEMO_SOURCE=vod
POLYV_VOD_PAGE_SIZE=50
POLYV_DEMO_VOD_TITLE=

# ── 可选：AI 复盘（教师端「用 AI 生成解读」才需要）──────────────────
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_API_KEY=
# LLM_BASE_URL=

# ── 服务端口 ────────────────────────────────────────────────────────
PORT=8787

# ── 可选：本地转写兜底（默认不启用）────────────────────────────────
# ASR_PYTHON=python
