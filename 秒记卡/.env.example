# ─────────────────────────────────────────────────────────────────────
# 秒记卡 · 环境变量模板
# 用法：复制成 秒记卡/.env.local，把真的值填进去，然后 npm start
#   复制：  Copy-Item .env.example .env.local
#   说明：  docs/配置说明.md
# .env.local 已被 .gitignore 忽略，不会进版本库；也不要提交到任何仓库。
# ─────────────────────────────────────────────────────────────────────

# ── 必填 ①：保利威直播 Open API（签名算法 MD5）──────────────────────
# 后台位置：保利威直播后台 → 设置 → 开发者信息（AppID / AppSecret）
# 用于：频道信息、录制文件列表、回放/暂存列表、频道播放列表设置
POLYV_APP_ID=
POLYV_APP_SECRET=

# ── 必填 ②：保利威点播 Open API（签名算法 SHA1）────────────────────
# 后台位置：保利威点播后台 → 设置 → 开发者信息
# 注意：userid 不是登录账号，是接口签名里的 userid 字段
# 用于：点播视频列表（含 mp4 直链）、点播智能字幕（/v2/video/{userid}/srt/list）
POLYV_VOD_USERID=
POLYV_VOD_SECRETKEY=

# ── 必填 ③：频道号（学生端与教师端都用它）──────────────────────────
# 从观看页地址里抄：https://live.polyv.cn/watch/<这串数字>
# 注意：留空不会报错，但前端会退回代码里的兜底常量 8569582 —— 那是别人的频道
POLYV_DEMO_CHANNEL_ID=

# ── 选填 ④：默认打开哪条视频（留空 = 该频道点播列表的第一条）──────
# 填点播视频的 vid（接口返回的 vid 字段），不是标题
# 留空能跑，但教师端默认复盘会变成空标题（vod:），建议还是填上
POLYV_DEMO_VIDEO_ID=
# 演示锁定点播（留空则由频道播放列表配置决定）
POLYV_DEMO_SOURCE=vod
# 点播列表一次拉多少条
POLYV_VOD_PAGE_SIZE=50
# 仅当点播库取不到标题时的兜底标题（一般留空）
POLYV_DEMO_VOD_TITLE=

# ── 可选：AI 复盘（不配也能跑，教师端只显示规则模板）────────────────
# 三种写法：
#   DeepSeek：LLM_PROVIDER=deepseek  LLM_MODEL=deepseek-chat  LLM_API_KEY=sk-...
#   通义千问：LLM_PROVIDER=dashscope LLM_MODEL=qwen-plus       LLM_API_KEY=sk-...
#   自建/代理：LLM_PROVIDER=custom   LLM_MODEL=...             LLM_BASE_URL=https://...
# 也接受 DEEPSEEK_API_KEY / DASHSCOPE_API_KEY 这两个变量名，二选一即可。
LLM_PROVIDER=dashscope
LLM_MODEL=qwen-plus
LLM_API_KEY=
# LLM_BASE_URL=

# ── 服务端口 ────────────────────────────────────────────────────────
PORT=8787

# ── 可选：本地转写兜底（默认不启用，平台有智能字幕就不需要）────────
# 需要先 pip install -r requirements-asr.txt
# ASR_PYTHON=python
