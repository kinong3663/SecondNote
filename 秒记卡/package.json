{
  "name": "second-note",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env.local --watch server/index.mjs\" \"vite --configLoader runner --host 0.0.0.0\"",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build --configLoader runner",
    "postbuild": "node ../scripts/sync-teacher.mjs",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "demo": "npm run build && npm start",
    "preview": "vite preview --configLoader runner --host 0.0.0.0"
  },
  "dependencies": {
    "@polyv/live-watch-sdk": "^2.20.0",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
